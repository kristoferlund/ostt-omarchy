#!/bin/bash

# Records from the default microphone without a terminal, then hands the
# recording to `ostt transcribe --paste`. Each command returns at once; the
# recorder and the transcription run in the background.
#
# Apps listed in ~/.config/ostt/dictate.toml send the transcript through their
# processing action; with screenshot = true, a screenshot of the window taken
# at start is attached.
#
#   ostt-dictate start | stop | toggle | cancel
#   ostt-dictate status [--json] [--follow]
#   ostt-dictate levels   follow the input level while recording
#   ostt-dictate apps     JSON: processing actions, and the apps on visible
#                         workspaces or in the config, with their name and
#                         settings
#   ostt-dictate map <class> [<action> [--screenshot]]
#                         set an app's action; no action clears it

set -u

dir="${XDG_RUNTIME_DIR:-/tmp/ostt-dictate-$UID}/ostt-dictate"
audio="$dir/recording.wav"
recorder_pid="$dir/recorder.pid"
worker_pid="$dir/worker.pid"
error_file="$dir/error"
levels="$dir/levels"
context="$dir/context.jpg"
action_file="$dir/action"
config="${XDG_CONFIG_HOME:-$HOME/.config}/ostt/dictate.toml"

mkdir -p "$dir" && chmod 700 "$dir"

notify() {
  notify-send -a OSTT -i audio-input-microphone "$1" "$2" 2>/dev/null || true
}

fail() {
  echo "ostt-dictate: $1" >&2
  notify "Dictation failed" "$1"
  exit 1
}

# True while the process in the pid file is alive and still the one we started.
running() {
  local pid
  pid=$(cat "$1" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] && grep -qa "$2" "/proc/$pid/cmdline" 2>/dev/null
}

recording() { running "$recorder_pid" ffmpeg; }
transcribing() { running "$worker_pid" ostt-dictate; }

state() {
  if recording; then
    echo recording
  elif transcribing; then
    echo transcribing
  elif [[ -s $error_file ]]; then
    echo error
  else
    echo idle
  fi
}

# Press and release of a hold key arrive almost together; take turns.
lock() {
  exec 8>"$dir/lock"
  flock -w 10 8 || fail "Dictation is busy; try again."
}

# Looks up the focused app in the config. A listed app gets its action, and a
# screenshot of its window if it asks for one; any other app gets plain
# dictation. Problems are reported and fall back to plain dictation rather
# than blocking it.
pick_action() {
  [[ -f $config ]] || return 0
  local win class apps action actions
  win=$(hyprctl activewindow -j 2>/dev/null) || return 0
  class=$(jq -r '.class // empty' <<<"$win" 2>/dev/null)
  [[ $class ]] || return 0
  if ! apps=$(config_apps 2>&1); then
    notify "Dictating without context" "Could not read $config: ${apps##*$'\n'}"
    return 0
  fi
  action=$(jq -r --arg class "$class" '.[$class].action // empty' <<<"$apps")
  [[ $action ]] || return 0
  if ! actions=$(ostt process list --format json 2>&1); then
    notify "Dictating without context" "Could not list OSTT's processing actions: ${actions##*$'\n'}"
    return 0
  fi
  if ! jq -e --arg id "$action" 'any(.[]; .id == $id)' <<<"$actions" >/dev/null; then
    notify "Dictating without context" "$class is set to '$action', which is not a processing action in ostt.toml."
    return 0
  fi
  # JPEG at 60% keeps small text legible at a fraction of the PNG size.
  if jq -e --arg class "$class" '.[$class].screenshot' <<<"$apps" >/dev/null &&
    ! grim -t jpeg -q 60 -g "$(jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' <<<"$win")" "$context" 2>/dev/null; then
    rm -f "$context"
    notify "Dictating without context" "Could not take a screenshot of $class."
    return 0
  fi
  printf '%s\n' "$action" >"$action_file"
}

# Sends SIGINT so ffmpeg finishes the WAV header, and waits for it.
stop_recorder() {
  local pid
  pid=$(cat "$recorder_pid")
  kill -INT "$pid" 2>/dev/null
  for _ in {1..40}; do
    recording || break
    sleep 0.05
  done
  recording && kill -KILL "$pid" 2>/dev/null
  rm -f "$recorder_pid"
}

start() {
  recording && return 0
  transcribing && fail "Still transcribing the previous dictation."
  command -v ostt >/dev/null || fail "OSTT is not installed."
  # A missing model fails at the key press, not after speaking.
  ostt model current >/dev/null 2>&1 || fail "No transcription model is selected. Run 'ostt model'."

  rm -f "$error_file" "$audio" "$context" "$action_file"
  : >"$levels"
  # One capture: 16 kHz mono WAV for OSTT, and the RMS level every 50 ms for
  # the popup's meter.
  setsid ffmpeg -nostdin -hide_banner -loglevel error -f pulse -i default -filter_complex \
    "[0:a]aresample=16000,aformat=sample_fmts=s16:channel_layouts=mono,asplit[rec][meter];[meter]asetnsamples=n=800,astats=metadata=1:reset=1:measure_perchannel=none,ametadata=print:key=lavfi.astats.Overall.RMS_level:direct=1:file=$levels[out]" \
    -map "[rec]" -c:a pcm_s16le "$audio" -map "[out]" -f null - \
    </dev/null >/dev/null 2>"$dir/recorder.log" 8>&- &
  echo $! >"$recorder_pid"
  sleep 0.1
  if ! recording; then
    rm -f "$recorder_pid"
    fail "Could not start the microphone: $(tail -n1 "$dir/recorder.log")"
  fi
  # After the microphone starts, so the first word isn't lost; before the
  # popup appears, though it never takes focus anyway.
  pick_action
  # Show the recording popup when the Omarchy shell is running.
  omarchy-shell -q shell summon ostt.dictation '{}' </dev/null >/dev/null 2>&1 8>&- &
}

stop() {
  recording || return 0
  stop_recorder
  setsid "$0" __transcribe </dev/null >/dev/null 2>&1 8>&- &
  echo $! >"$worker_pid"
}

cancel() {
  if recording; then
    stop_recorder
    rm -f "$audio"
  elif transcribing; then
    kill -TERM -- "-$(cat "$worker_pid")" 2>/dev/null
    rm -f "$worker_pid" "$audio"
  fi
  rm -f "$context" "$action_file"
}

# The background half of stop: transcribe, process, paste, report failures.
transcribe() {
  local output action args=(--paste)
  action=$(cat "$action_file" 2>/dev/null)
  [[ $action ]] && args+=(--process "$action")
  [[ $action && -f $context ]] && args+=(--attach "$context")
  if output=$(ostt transcribe "$audio" "${args[@]}" 2>&1 >/dev/null); then
    rm -f "$audio" "$context"
  else
    # ostt prints its own explanation last; keep the files for a retry.
    output=$(printf '%s\n' "$output" | grep -v '^\s*$' | tail -n1)
    printf '%s\n' "${output:-Transcription failed.}" >"$error_file"
    notify "Dictation failed" "${output:-Transcription failed.} Retry with: ostt transcribe $audio ${args[*]}"
  fi
  rm -f "$worker_pid" "$action_file"
}

# Reads [apps] from the config as a JSON object of
# class -> { action, screenshot }. Any malformed entry fails the whole file.
config_apps() {
  [[ -f $config ]] || { echo '{}'; return 0; }
  python3 - "$config" <<'EOF'
import json, sys, tomllib
with open(sys.argv[1], "rb") as f:
    apps = tomllib.load(f).get("apps", {})
if not isinstance(apps, dict):
    sys.exit("[apps] must be a table")
out = {}
for app, entry in apps.items():
    if not (isinstance(entry, dict) and isinstance(entry.get("action"), str)
            and isinstance(entry.get("screenshot", False), bool)):
        sys.exit(f'"{app}" must look like {{ action = "screen-context", screenshot = true }}')
    out[app] = {"action": entry["action"], "screenshot": entry.get("screenshot", False)}
print(json.dumps(out))
EOF
}

apps() {
  [[ -f $config ]] || { echo '{}'; return 0; }
  python3 - "$config" <<'EOF'
import json, sys, tomllib
with open(sys.argv[1], "rb") as f:
    apps = tomllib.load(f).get("apps", {})
if not isinstance(apps, dict):
    sys.exit("[apps] must be a table")
print(json.dumps({k: v for k, v in apps.items() if isinstance(v, str)}))
EOF
}

# Prints a JSON object of window class -> app name, from the desktop entries
# whose StartupWMClass or file name matches the class. Earlier data dirs win.
app_names() {
  python3 - "$@" <<'EOF'
import glob, json, os, sys
classes = {c.lower(): c for c in sys.argv[1:]}
dirs = [os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")]
dirs += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
names = {}
for d in dirs:
    for path in sorted(glob.glob(os.path.join(d, "applications", "*.desktop"))):
        entry, section = {}, None
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("["):
                        section = line
                    elif section == "[Desktop Entry]" and "=" in line:
                        key, value = line.split("=", 1)
                        entry.setdefault(key.strip(), value.strip())
        except OSError:
            continue
        if not entry.get("Name") or entry.get("Hidden") == "true":
            continue
        stem = os.path.basename(path)[:-len(".desktop")].lower()
        for key in (entry.get("StartupWMClass", "").lower(), stem, stem.rsplit(".", 1)[-1]):
            if key in classes:
                names.setdefault(classes[key], entry["Name"])
print(json.dumps(names))
EOF
}

apps() {
  local clients workspaces mapped actions classes names error=""
  clients=$(hyprctl clients -j 2>/dev/null) || clients='[]'
  workspaces=$(hyprctl monitors -j 2>/dev/null | jq '[.[].activeWorkspace.id]') || workspaces='[]'
  if ! mapped=$(config_apps 2>&1); then
    error="Could not read $config: ${mapped##*$'\n'}"
    mapped='{}'
  fi
  actions=$(ostt process list --format json 2>/dev/null) || actions='[]'
  mapfile -t classes < <(jq -r '.[].class' <<<"$clients" 2>/dev/null; jq -r 'keys[]' <<<"$mapped")
  names=$(app_names "${classes[@]}" 2>/dev/null) || names='{}'
  jq -n --argjson clients "$clients" --argjson workspaces "$workspaces" \
    --argjson mapped "$mapped" --argjson actions "$actions" --argjson names "$names" --arg error "$error" '
    ($clients
      | map(select(.class != "" and (.workspace.id as $id | $workspaces | index($id))))
      | group_by(.class) | map({class: .[0].class, title: .[0].title})) as $visible
    | ($mapped | keys - ($visible | map(.class)) | map({class: ., title: ""})) as $elsewhere
    | {error: $error, actions: $actions,
       apps: (($visible + $elsewhere)
         | map(. + {name: ($names[.class] // .class), action: ($mapped[.class].action // ""),
                   screenshot: ($mapped[.class].screenshot // false)}))}'
}

# Sets or clears one app's entry under [apps], keeping the rest of the file
# as written, and replaces the file only once the result parses.
map_app() {
  if [[ ! ${1:-} ]] || (( $# > 3 )) || [[ $# == 3 && $3 != --screenshot ]]; then
    echo "Usage: ostt-dictate map <class> [<action> [--screenshot]]" >&2
    exit 1
  fi
  mkdir -p "${config%/*}"
  python3 - "$config" "$1" "${2:-}" "${3:+1}" <<'EOF'
import json, os, re, sys, tempfile, tomllib
path, app, action, screenshot = sys.argv[1:5]
entry = {"action": action, "screenshot": bool(screenshot)} if action else None
try:
    with open(path) as f:
        lines = f.read().splitlines()
except FileNotFoundError:
    lines = []

key = re.compile(r'^\s*(?:"((?:[^"\\]|\\.)*)"|([A-Za-z0-9_-]+))\s*=')
def key_of(line):
    m = key.match(line)
    if not m:
        return None
    return json.loads(f'"{m.group(1)}"') if m.group(1) is not None else m.group(2)

start = next((i for i, l in enumerate(lines) if l.strip() == "[apps]"), None)
if start is None:
    if lines and lines[-1].strip():
        lines.append("")
    lines.append("[apps]")
    start = len(lines) - 1
end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
section = [l for l in lines[start + 1:end] if key_of(l) != app]
if action:
    last_key = max((i for i, l in enumerate(section) if key_of(l) is not None), default=-1)
    value = json.dumps(action, ensure_ascii=False)
    flag = "true" if screenshot else "false"
    section.insert(last_key + 1, f"{json.dumps(app, ensure_ascii=False)} = {{ action = {value}, screenshot = {flag} }}")
text = "\n".join(lines[:start + 1] + section + lines[end:]) + "\n"

try:
    tomllib.loads("\n".join(lines))
    updated = tomllib.loads(text).get("apps", {}).get(app)
except tomllib.TOMLDecodeError as e:
    sys.exit(f"{path} is not valid TOML: {e}")
if updated != entry:
    sys.exit(f"Could not update {path}")
target = os.path.realpath(path)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".dictate.")
with os.fdopen(fd, "w") as f:
    f.write(text)
if os.path.exists(target):
    os.chmod(tmp, os.stat(target).st_mode & 0o777)
os.replace(tmp, target)
EOF
}

status() {
  local json="" follow="" last="" current
  for arg in "$@"; do
    case $arg in
      --json) json=1 ;;
      --follow) follow=1 ;;
      *) echo "Usage: ostt-dictate status [--json] [--follow]" >&2; exit 1 ;;
    esac
  done
  while :; do
    current=$(state)
    if [[ $json ]]; then
      current=$(jq -cn --arg state "$current" --rawfile error <(cat "$error_file" 2>/dev/null) \
        '{state: $state} + (if $state == "error" then {error: ($error | rtrimstr("\n"))} else {} end)')
    fi
    if [[ $current != "$last" ]]; then
      # Exit once the reader (a bar widget) goes away.
      printf '%s\n' "$current" || exit 0
      last=$current
    fi
    [[ $follow ]] || return 0
    sleep 0.2
  done
}

case "${1:-}" in
  start) lock; start ;;
  stop) lock; stop ;;
  toggle)
    lock
    if recording; then stop; else start; fi
    ;;
  cancel) lock; cancel ;;
  status) shift; status "$@" ;;
  levels) exec tail -n0 -F "$levels" 2>/dev/null ;;
  apps) apps ;;
  map) shift; map_app "$@" ;;
  __transcribe) transcribe ;;
  *) echo "Usage: ostt-dictate <start|stop|toggle|cancel|status [--json] [--follow]|levels|apps|map <class> [<action> [--screenshot]]>" >&2; exit 1 ;;
esac
